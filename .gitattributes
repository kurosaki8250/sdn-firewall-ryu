# Normalize to LF in the repository; keep Windows scripts native.
* text=auto

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
Dockerfile      text eol=lf
LICENSE         text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf
